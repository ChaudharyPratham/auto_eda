# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ─── CORS – comma-separated list of allowed origins ──────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Max upload size in MB ────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500

# ─── PostgreSQL database (optional – metadata storage) ───────────────────────
# If blank, DB operations are silently skipped.
DATABASE_URL=postgresql://user:password@localhost:5432/autoeda

# ─── Data API key (guards GET /api/data/{file_id}) ───────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=your-api-key-here

# ─── Cloud Storage – Azure Blob Storage ──────────────────────────────────────
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=

# ─── Cloud Storage – AWS S3 ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# ─── Cloud Storage – Google Cloud Storage ────────────────────────────────────
GCP_PROJECT_ID=
GCP_CREDENTIALS_JSON=   # path to service-account JSON file

# ─── Databricks ───────────────────────────────────────────────────────────────
DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_HTTP_PATH=
